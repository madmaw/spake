{
    "author": "",
    "dependencies": {
        "@react-three/drei": "^10.7.0",
        "@react-three/fiber": "^9.3.0",
        "@tabler/icons-react": "^3.46.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "three": "^0.180.0"
    },
    "description": "A speaking aid: chain sentences together from a radial word cloud, spoken aloud as you go",
    "devDependencies": {
        "@babel/core": "^7.26.10",
        "@babel/plugin-transform-typescript": "^7.26.10",
        "@biomejs/biome": "^2.4.16",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint-react/eslint-plugin": "^3.0.0",
        "@eslint/js": "^9.37.0",
        "@rolldown/plugin-babel": "^0.2.3",
        "@storybook/addon-vitest": "^10.4.2",
        "@storybook/builder-vite": "^10.4.2",
        "@storybook/react": "^10.4.2",
        "@storybook/react-vite": "^10.4.2",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/css-modules": "^1.0.5",
        "@types/node": "^22.18.8",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/three": "^0.180.0",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/browser-playwright": "^4.1.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.37.0",
        "eslint-config-biome": "^2.1.3",
        "eslint-parser-plain": "^0.1.1",
        "eslint-plugin-no-relative-import-paths": "^1.6.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^15.15.0",
        "happy-dom": "^20.8.3",
        "jiti": "^2.5.1",
        "playwright": "^1.60.0",
        "storybook": "^10.4.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.60.0",
        "typescript-plugin-css-modules": "^5.1.0",
        "vite": "^8.0.16",
        "vite-css-modules": "^1.16.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.8",
        "vitest-fail-on-console": "^0.10.1"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.13.1"
    },
    "license": "ISC",
    "name": "spake",
    "packageManager": "pnpm@10.13.1",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "esbuild"
        ]
    },
    "private": true,
    "scripts": {
        "all": "pnpm install && pnpm check-types && pnpm lint:ci && pnpm test && pnpm test:storybook && pnpm build",
        "build": "pnpm check-types && vite build --configLoader runner",
        "check-types": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
        "data:bigrams": "node scripts/build-bigrams.mjs",
        "data:icons": "node scripts/build-icons.mjs",
        "dev": "vite --configLoader runner",
        "lint": "pnpm lint:biome && pnpm lint:es",
        "lint:biome": "biome check --error-on-warnings",
        "lint:biome:fix": "biome check --write --unsafe",
        "lint:ci": "CI=true pnpm lint",
        "lint:es": "eslint",
        "lint:es:fix": "eslint --fix",
        "lint:fix": "pnpm lint:biome:fix && pnpm lint:es:fix",
        "preview": "vite preview --configLoader runner",
        "start": "vite --configLoader runner",
        "storybook": "storybook dev",
        "storybook:build": "storybook build",
        "test": "pnpm vitest:run --project=unit",
        "test:storybook": "pnpm exec playwright install chromium-headless-shell && pnpm vitest:run --project=storybook",
        "test:update": "pnpm vitest:run -u --project=unit",
        "test:watch": "vitest --configLoader runner --project=unit",
        "vitest:run": "vitest run --configLoader runner"
    },
    "type": "module",
    "version": "0.0.0"
}
